# Local development only. Replace these values in your untracked .env file.
POSTGRES_USER=studyduel
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=studyduel

# Use the same values as above. Replace the password with your local value.
DATABASE_URL=postgresql://studyduel:change-this-local-password@localhost:5432/studyduel

# Add Google OAuth credentials only when implementing Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=

# Email verification for password-based account registration (Resend).
# Create an API key and verify the sender domain in Resend before production use.
# RESEND_API_KEY=re_...
# EMAIL_FROM=StudyDuel <verify@your-domain.example>
