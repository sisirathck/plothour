# Local development only. Replace these values in your untracked .env file.
POSTGRES_USER=studyduel
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=studyduel

# Use the same values as above. Replace the password with your local value.
DATABASE_URL=postgresql://studyduel:change-this-local-password@localhost:5432/studyduel

# Add Google OAuth credentials only when implementing Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=
# Administrator roles are stored in the users table and applied by database migrations.

# Email verification for password-based account registration (SMTP or Resend).
SMTP_HOST=mail.your-domain.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply
SMTP_PASS=your-smtp-password
EMAIL_FROM=PlotHour <noreply@your-domain.example>

# Alternative: Resend API
# RESEND_API_KEY=re_...
